{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native debug (tests)",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BLLM_ENABLE_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native release (tests)",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly release (browser)",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-diag",
      "displayName": "WebAssembly diagnostic (Release + instrumentation)",
      "binaryDir": "${sourceDir}/build/wasm-diag",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLLM_ENABLE_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "native-diag",
      "displayName": "Native diagnostic (Release + instrumentation)",
      "binaryDir": "${sourceDir}/build/native-diag",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLLM_ENABLE_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "native-sanitize",
      "displayName": "Native tests under AddressSanitizer and UBSan (Linux)",
      "binaryDir": "${sourceDir}/build/native-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all",
        "BLLM_ENABLE_DIAGNOSTICS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    },
    {
      "name": "wasm-diag",
      "configurePreset": "wasm-diag"
    },
    {
      "name": "native-diag",
      "configurePreset": "native-diag"
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
